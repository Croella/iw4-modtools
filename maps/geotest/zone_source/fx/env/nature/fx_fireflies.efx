iwfx 3

// Fireflies: small glowing lights that drift around a spot, blink on and off, and fade out.
// An example effect written by hand (iw4-radiant compiles .efx files from zone_source/fx).
//
// Place it with an fx_origin entity, key "fx" = "env/nature/fx_fireflies". The fx_origin's default
// angles (270 0 0) point the effect's X axis straight up, so below: X = height, Y/Z = the ground plane.
//
// Every "graph" is two curves (time 0..1 over the particle's life -> value, scaled by the number
// after the graph name). With a useRand* editor flag, each particle gets a random blend between
// curve 1 and curve 2, which is what makes every firefly move and blink differently.

	efFlags;
	efPriority 30;
	efBoundingBoxDim 0 0 0;
	efBoundingBoxCentre 0 0 0;
{
	name "fireflies";
	editorFlags looping useRandColor useRandAlpha useRandSize0 useRandVel0 useRandVel1;
	flags spawnRelative spawnRelativeType0 spawnFrustumCull spawnOffsetNone runRelToSpawn;
	spawnRange 0 3000;               // only while the player is within 3000 units
	fadeInRange 0 0;
	fadeOutRange 0 0;
	spawnFrustumCullRadius 300;
	spawnLooping 175 0;              // a new firefly every 175 ms, forever (about 40 alive at once)
	spawnOneShot 0 0;                // (only used by one-shot elements)
	spawnDelayMsec 0 0;
	lifeSpanMsec 5000 4000;          // each lives 5-9 seconds (base, random extra)
	spawnOrgX 16 80;                 // 16-96 units off the ground
	spawnOrgY -256 512;              // over a 512 x 512 area
	spawnOrgZ -256 512;
	spawnOffsetRadius 0 0;
	spawnOffsetHeight 0 0;
	spawnAnglePitch 0 0;
	spawnAngleYaw 0 0;
	spawnAngleRoll 0 0;
	angleVelPitch 0 0;
	angleVelYaw 0 0;
	angleVelRoll 0 0;
	initialRot 0 0;
	rotationAxis 0 0 0 1;
	gravity 0 0;                     // they float
	elasticity 0 0;
	windinfluence 0;
	atlasBehavior startRandom;
	atlasIndex 0;
	atlasFps 0;
	atlasLoopCount 0;
	atlasColIndexBits 0;
	atlasRowIndexBits 0;
	atlasEntryCount 0;
	atlasIndexRange 0;

	// Lazy wandering: velocity curves that swing back and forth (units per second).
	velGraph0X 14                    // slow bob up and down
	{
		{
			0 0.5
			0.3 -0.4
			0.65 0.45
			1 -0.3
		}
		{
			0 -0.4
			0.4 0.5
			0.8 -0.5
			1 0.2
		}
	};
	velGraph0Y 40
	{
		{
			0 -0.5
			0.25 0.3
			0.6 -0.4
			1 0.5
		}
		{
			0 0.5
			0.45 -0.5
			0.75 0.2
			1 -0.3
		}
	};
	velGraph0Z 40
	{
		{
			0 0.2
			0.35 -0.5
			0.7 0.5
			1 -0.1
		}
		{
			0 -0.3
			0.3 0.5
			0.55 -0.2
			1 0.5
		}
	};
	// A little extra jitter on top.
	velGraph1X 6
	{
		{
			0 0
			0.5 0.5
			1 0
		}
		{
			0 0
			0.5 -0.5
			1 0
		}
	};
	velGraph1Y 10
	{
		{
			0 0.5
			0.5 -0.5
			1 0.5
		}
		{
			0 -0.5
			0.5 0.5
			1 -0.5
		}
	};
	velGraph1Z 10
	{
		{
			0 -0.5
			0.5 0.5
			1 -0.5
		}
		{
			0 0.5
			0.5 -0.5
			1 0.5
		}
	};
	rotGraph 0
	{
		{
			0 0
			1 0
		}
		{
			0 0
			1 0
		}
	};

	// Size: the flare texture is a small hot core in a wide dark square, so the sprite is much bigger
	// than the visible dot: 17-28 units across, popping in and shrinking away at the end.
	sizeGraph0 28
	{
		{
			0 0
			0.08 1
			0.9 1
			1 0
		}
		{
			0 0
			0.08 0.6
			0.9 0.6
			1 0
		}
	};
	sizeGraph1 0
	{
		{
			0 1
			1 1
		}
		{
			0 1
			1 1
		}
	};
	scaleGraph 1
	{
		{
			0 1
			1 1
		}
		{
			0 1
			1 1
		}
	};

	// Colour: warm yellow-green, some a little more yellow.
	colorGraph 1
	{
		{
			0 0.72 1 0.18
			1 0.72 1 0.18
		}
		{
			0 1 0.9 0.35
			1 1 0.9 0.35
		}
	};

	// The blink: the light fades in, glows, fades out, and comes back - twice or three times a life,
	// at different moments on the two curves - then fades away for good.
	alphaGraph 1
	{
		{
			0 0
			0.06 1
			0.2 1
			0.28 0.05
			0.42 0.05
			0.5 1
			0.62 0.9
			0.7 0.05
			0.8 0.05
			0.86 1
			0.94 0.8
			1 0
		}
		{
			0 0
			0.15 0.05
			0.22 0.9
			0.4 1
			0.5 0.05
			0.66 0.05
			0.74 1
			0.9 0.9
			1 0
		}
	};

	lightingFrac 0;                  // they glow: not darkened by the level's lighting
	collOffset 0 0 0;
	collRadius 0;
	fxOnImpact "";
	fxOnDeath "";
	sortOrder 5;
	emission "";
	emitDist 1 0;
	emitDistVariance 0 0;
	attachment "";
	trailSplitDist 0;
	trailScrollTime 0;
	trailRepeatDist 0;
	alphafadetimemsec 0;
	maxwind_mag 0;
	maxwind_life 0;
	maxwind_interval 1;
	billboardTopWidth 1;
	billboardBottomWidth 1;
	elemSpawnSound
	{
	};
	cloudDensity 1024 0;
	billboardPivot 0 0;
	// A camera-facing sprite with an additive soft flare (BO1's firefly material, imported
	// automatically with its image when the map compiles).
	billboardSprite
	{
		"gfx_fxt_light_flare2_eo15"
	};
}
